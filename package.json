{
  "name": "termudrive",
  "version": "1.0.0",
  "description": "Reliable Google Drive uploads from Android through Termux",
  "type": "module",
  "main": "src/app.js",
  "bin": { "termudrive": "cli/termudrive.js" },
  "scripts": {
    "start": "node src/app.js",
    "dev": "TERMUDRIVE_FOREGROUND=1 node --watch src/app.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "lint": "node --check src/app.js && node --check cli/termudrive.js",
    "doctor": "node cli/termudrive.js doctor"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": { "ws": "^8.18.3" },
  "license": "MIT"
}
